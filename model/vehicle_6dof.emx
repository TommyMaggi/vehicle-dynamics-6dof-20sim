      R3 408 24
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\R.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:35:37</TimeStamp>
</Description>
</Information>';
       type R
        ports
         power in p_x;
         power in p_y;
         signal in ut_in;
         signal in F_z_in;
       end;
       icon bg ellipse bottom
        figures
         text 'R' 408 24 color 0 18 bold;
       end;
       implementation eq
parameters
    real global mass_wheel;
    real global epsilon;

    real global pacejka_B_long;
    real global pacejka_C_long;
    real global pacejka_D_long;
    real global pacejka_E_long;
    
    real global pacejka_B_lat;
    real global pacejka_C_lat;
    real global pacejka_D_lat;
    real global pacejka_E_lat;

variables
    real s;              // Scorrimento longitudinale
    real alpha;          // Angolo di deriva
    real F_L0;           // Forza longitudinale pura
    real F_C0;           // Forza laterale pura
    real g_Lalpha;       // Fattore di perdita combinato
    real g_Cs;           // Fattore di perdita combinato
    
    real F_z_static;     // Carico normale costante [N]
    real r_omega_t;      // Velocità tangenziale

    real F_z_dynamic;

equations
    // CARICO NORMALE STATICO --
    //F_z_static = (mass_wheel + 300.0) * 9.81;

    F_z_dynamic = max(F_z_in, 1.0);

    // CALCOLO VELOCITÀ REALI --
    r_omega_t = p_x.f + ut_in;    

    // CALCOLO SLIP E DERIVA --
    s = p_x.f / max(ut_in, max(r_omega_t, epsilon));        
    alpha = arctan(p_y.f / max(ut_in, epsilon));

    // FORMULE DI PACEJKA PURE --
    F_L0 = pacejka_D_long * sin(pacejka_C_long * arctan(pacejka_B_long * s - pacejka_E_long * (pacejka_B_long * s - arctan(pacejka_B_long * s))));
    F_C0 = pacejka_D_lat * sin(pacejka_C_lat * arctan(pacejka_B_lat * alpha - pacejka_E_lat * (pacejka_B_lat * alpha - arctan(pacejka_B_lat * alpha))));

    // FATTORI DI PERDITA COMBINATA --
    g_Lalpha = cos(pacejka_C_long * arctan(pacejka_B_long * alpha));
    g_Cs     = cos(pacejka_C_lat  * arctan(pacejka_B_lat  * s));

    // USCITE DI SFORZO VERSO IL TELAIO --
    // La forza della gomma deve OPPORSI allo scivolamento (reazione vincolare).
    p_x.e = F_L0 * g_Lalpha * F_z_dynamic;
    p_y.e = F_C0 * g_Cs     * F_z_dynamic;implementation_end;
      TF 392 288
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\TF.emx</LibraryPath>
