 <Model version="5.1" build="5.1.6.14106">
  <Sidops><![CDATA[model 128 184
 description '<Information>
  <Description>
    <Version>5.1</Version>
    <IsMainModel>0</IsMainModel>
    <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>C:\Users\giorg\Qsync\Universit&agrave;\uni_appunti\Uni_quarto_anno\Modelling\20sim\car_3.emx</LibraryPath>
    <TimeStamp>2026-6-30 21:57:47</TimeStamp>
  </Description>
  <Attributes>
    <GlobalRelations>parameters
    // Parametri Body
    real m = 1500.0;       // Massa (kg)
    real Jx = 400.0;       // Inerzia Rollio (kg*m^2)
    real Jy = 1200.0;      // Inerzia Beccheggio (kg*m^2)
    real Jz = 1500.0;      // Inerzia Imbardata (kg*m^2)
    real a = 1.2;          // Distanza CG - asse anteriore (m)
    real b = 1.3;          // Distanza CG - asse posteriore (m)
    real w = 0.8;          // Semi-carreggiata (m)
    real h = 0.6;            // Altezza del baricentro dal suolo (m)

    real differential_ratio = 3.5;

    // Parametri Ruota (Wheel)
    real radius_wheel = 0.25;      // Raggio ruota (m)
    real inertia_wheel = 1.0;      // Inerzia polare ruota (kg*m^2)
    real mass_wheel = 40.0;        // Massa non sospesa (kg)
    real epsilon = 0.5;         // Tolleranza numerica
    
    // Parametri Verticali (Sospensione)
    real stiffness_tire_z = 200000.0;
    real stiffness_suspension_z = 22000.0;
    real damping_suspension_z = 2000.0;
    
    // Variabile globale dinamica per la compressione iniziale
    real global initial_compression_z = (m * 9.81) / (4.0 * stiffness_suspension_z);
    
    // Parametri Boccole
    real stiffness_bushing_x = 500000.0;
    real stiffness_bushing_y = 200000.0;
    // Smorzamento delle boccole
    real damping_bushing_x = 2000.0;
    real damping_bushing_y = 2000.0;
    
    // Coefficienti Pacejka Longitudinale
    real pacejka_B_long = 10.0;
    real pacejka_C_long = 1.9;
    real pacejka_D_long = 1.0;
    real pacejka_E_long = 0.97;
    
    // Coefficienti Pacejka Laterale
    real pacejka_B_lat = 7.14;
    real pacejka_C_lat = 1.3;
    real pacejka_D_lat = 1.0;
    real pacejka_E_lat = -0.2;</GlobalRelations>
  </Attributes>
</Information>';
 type 'Mainmodel-E52F'
 end;
 implementation bg
  submodels
   CAR_BODY 688 336
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Equation'
     ports
      power in x_car_body_BL;
      power in y_car_body_BL;
      power in z_car_body_BL;
      power in x_car_body_BR;
      power in y_car_body_BR;
      power in z_car_body_BR;
      power in x_car_body_FL;
      power in y_car_body_FL;
      power in z_car_body_FL;
      power in x_car_body_FR;
      power in y_car_body_FR;
      power in z_car_body_FR;
      signal out X_FL_global;
      signal out X_FR_global;
      signal out X_BL_global;
      signal out X_BR_global;
      signal out X_out;
      signal out Y_out;
      signal out psi_out;
      signal in delta_in;
     restrictions
      causality fixed in x_car_body_BL;
      causality fixed in y_car_body_BL;
      causality fixed in z_car_body_BL;
      causality fixed in x_car_body_BR;
      causality fixed in y_car_body_BR;
      causality fixed in z_car_body_BR;
      causality fixed in x_car_body_FL;
      causality fixed in y_car_body_FL;
      causality fixed in z_car_body_FL;
      causality fixed in x_car_body_FR;
      causality fixed in y_car_body_FR;
      causality fixed in z_car_body_FR;
    end;
    implementation eq
parameters
    real global m, Jx, Jy, Jz, a, b, w, h;
    
    // Steering angle (in radians).
    //real delta = 0;

variables
	 
    // GLOBAL FRAME VARIABLES
    real phi, theta, psi;                 // Angoli di Eulero (Roll, Pitch, Yaw)
    real phidot, thetadot, psidot;        // Derivate degli angoli di Eulero
    
    real delta;
    real vX, vY, vZ;                      // Velocità nel sistema globale
    real X_global, Y_global, Z_global;    // Posizione nel sistema globale (Traiettoria)
    
    real FX_global, FY_global, FZ_global; // Forze scaricate nel sistema globale

    // Internal state variables (Body frame)
    real vx, vy, vz;
    real wx, wy, wz;
    
    // Intermediate variables (Accelerations)
    real ax, ay, az;
    real alphax, alphay, alphaz;

    // Local forces rotated to Body Frame
    real Fx_FL_b, Fy_FL_b;
    real Fx_FR_b, Fy_FR_b;
    real Fx_BL_b, Fy_BL_b;
    real Fx_BR_b, Fy_BR_b;

    // Local hub velocities in Body frame before rotation
    real v_FL_x_b, v_FL_y_b;
    real v_FR_x_b, v_FR_y_b;

    // Total forces and moments
    real Fx_tot, Fy_tot, Fz_tot;
    real Mx_tot, My_tot, Mz_tot;

    real Y_FL_global, Y_FR_global, Y_BL_global, Y_BR_global;

equations

    // UPWARD: From Wheels to CG (Forces and Moments)
    delta = delta_in;

    // Front wheels - steering delta 2D rotational matrix
    Fx_FL_b = x_car_body_FL.e * cos(delta) - y_car_body_FL.e * sin(delta);
    Fy_FL_b = x_car_body_FL.e * sin(delta) + y_car_body_FL.e * cos(delta);

    Fx_FR_b = x_car_body_FR.e * cos(delta) - y_car_body_FR.e * sin(delta);
    Fy_FR_b = x_car_body_FR.e * sin(delta) + y_car_body_FR.e * cos(delta);

    // Rear wheels are fixed (delta = 0)
    Fx_BL_b = x_car_body_BL.e;
    Fy_BL_b = y_car_body_BL.e;

    Fx_BR_b = x_car_body_BR.e;
    Fy_BR_b = y_car_body_BR.e;

    // Pure sum of forces on axes (Body Frame)
    Fx_tot = Fx_FL_b + Fx_FR_b + Fx_BL_b + Fx_BR_b;
    Fy_tot = Fy_FL_b + Fy_FR_b + Fy_BL_b + Fy_BR_b;
    
    // Z-axis: Sum of vertical reactions minus gravity
    Fz_tot = z_car_body_BL.e + z_car_body_BR.e + z_car_body_FL.e + z_car_body_FR.e - m * 9.81;
    //Fz_tot = 0;

    // Torque calculation at CG
    // Roll and Pitch use Fx_tot and Fy_tot (Body frame)
    Mx_tot = w * (z_car_body_BL.e + z_car_body_FL.e - z_car_body_BR.e - z_car_body_FR.e) + h * Fy_tot;
    My_tot = -a * (z_car_body_FL.e + z_car_body_FR.e) + b * (z_car_body_BL.e + z_car_body_BR.e) + h * Fx_tot;
    //Mx_tot = 0;
    //My_tot = 0;
    
    // Yaw (Mz) uses individual forces ALREADY rotated to body frame
    Mz_tot = a * (Fy_FL_b + Fy_FR_b) - b * (Fy_BL_b + Fy_BR_b) - w * (Fx_FL_b - Fx_FR_b + Fx_BL_b - Fx_BR_b);


    //CORE: Newton-Euler Equations (At CG)
    ax = (Fx_tot / m) - wy*vz + wz*vy;
    ay = (Fy_tot / m) - wz*vx + wx*vz;
    az = (Fz_tot / m) - wx*vy + wy*vx;

    alphax = (Mx_tot + (Jy - Jz)*wy*wz) / Jx;
    alphay = (My_tot + (Jz - Jx)*wz*wx) / Jy;
    alphaz = (Mz_tot + (Jx - Jy)*wx*wy) / Jz;

    vx = int(ax);
    vy = int(ay);
    vz = int(az);
    wx = int(alphax);
    wy = int(alphay);
    wz = int(alphaz);


    // From CG to Hubs (Kinematic Transformation)
    
    //Rear Wheels (Wheel Frame coincides with Body Frame) Like point P from slides
    x_car_body_BL.f = vx - wy*h - wz*w;
    y_car_body_BL.f = vy + wx*h - wz*b;
    //z_car_body_BL.f = vz + wx*w + wy*b;

    x_car_body_BR.f = vx - wy*h + wz*w;
    y_car_body_BR.f = vy + wx*h - wz*b;
    //z_car_body_BR.f = vz - wx*w + wy*b;

    // Front Wheels (Transformed to Wheel Frame for Pacejka) Like point P from slides
    v_FL_x_b = vx - wy*h - wz*w;
    v_FL_y_b = vy + wx*h + wz*a;
    
    // Output to FL wheel (Rotation by steering angle) inverse rotational matrix
    x_car_body_FL.f = v_FL_x_b * cos(delta) + v_FL_y_b * sin(delta);
    y_car_body_FL.f = -v_FL_x_b * sin(delta) + v_FL_y_b * cos(delta);
    //z_car_body_FL.f = vz + wx*w - wy*a; // Z does not rotate with steering

    v_FR_x_b = vx - wy*h + wz*w;
    v_FR_y_b = vy + wx*h + wz*a;
    
    // Output to FR wheel
    x_car_body_FR.f = v_FR_x_b * cos(delta) + v_FR_y_b * sin(delta);
    y_car_body_FR.f = -v_FR_x_b * sin(delta) + v_FR_y_b * cos(delta);
    //z_car_body_FR.f = vz - wx*w - wy*a;

// --- Front Wheels (Sostituiamo vz con vZ globale) ---
    // Il resto per X e Y rimane uguale per le formule di Pacejka
    z_car_body_FL.f = vZ + phidot*w - thetadot*a; 
    z_car_body_FR.f = vZ - phidot*w - thetadot*a;

    // --- Rear Wheels ---
    z_car_body_BL.f = vZ + phidot*w + thetadot*b;
    z_car_body_BR.f = vZ - phidot*w + thetadot*b;


    // Trasformazione da Body a World (Eulero Z-Y-X)


    // Calcolo delle derivate degli angoli di Eulero partendo dalle velocità angolari (wx, wy, wz)
    phidot = wx + wy * sin(phi) * tan(theta) + wz * cos(phi) * tan(theta);
    thetadot = wy * cos(phi) - wz * sin(phi);
    psidot = (wy * sin(phi) + wz * cos(phi)) / cos(theta);

    // Integrazione per ottenere l'orientamento globale del veicolo
    phi = int(phidot);
    theta = int(thetadot);
    psi = int(psidot);

    // Trasformazione delle velocità dal Body Frame al World Frame tramite matrice di rotazione
    vX = vx*cos(psi)*cos(theta) + vy*(cos(psi)*sin(theta)*sin(phi) - sin(psi)*cos(phi)) + vz*(cos(psi)*sin(theta)*cos(phi) + sin(psi)*sin(phi));
    vY = vx*sin(psi)*cos(theta) + vy*(sin(psi)*sin(theta)*sin(phi) + cos(psi)*cos(phi)) + vz*(sin(psi)*sin(theta)*cos(phi) - cos(psi)*sin(phi));
    vZ = -vx*sin(theta) + vy*cos(theta)*sin(phi) + vz*cos(theta)*cos(phi);

    // Integrazione per ottenere la Posizione Globale (Traiettoria X, Y, Z)
    X_global = int(vX);
    Y_global = int(vY);
    Z_global = int(vZ,h);

    // Trasformazione delle forze totali dal Body Frame al World Frame
    FX_global = Fx_tot*cos(psi)*cos(theta) + Fy_tot*(cos(psi)*sin(theta)*sin(phi) - sin(psi)*cos(phi)) + Fz_tot*(cos(psi)*sin(theta)*cos(phi) + sin(psi)*sin(phi));
    FY_global = Fx_tot*sin(psi)*cos(theta) + Fy_tot*(sin(psi)*sin(theta)*sin(phi) + cos(psi)*cos(phi)) + Fz_tot*(sin(psi)*sin(theta)*cos(phi) - cos(psi)*sin(phi));
    FZ_global = -Fx_tot*sin(theta) + Fy_tot*cos(theta)*sin(phi) + Fz_tot*cos(theta)*cos(phi);

    //delta_out = delta;

    // Calcolo posizione globale ruote anteriori
    X_FL_global = X_global + a * cos(psi) - w * sin(psi);
    Y_FL_global = Y_global + a * sin(psi) + w * cos(psi);

    X_FR_global = X_global + a * cos(psi) + w * sin(psi);
    Y_FR_global = Y_global + a * sin(psi) - w * cos(psi);

    // Calcolo posizione globale ruote posteriori
    X_BL_global = X_global - b * cos(psi) - w * sin(psi);
    Y_BL_global = Y_global - b * sin(psi) + w * cos(psi);

    X_BR_global = X_global - b * cos(psi) + w * sin(psi);
    Y_BR_global = Y_global - b * sin(psi) - w * cos(psi);

	 X_out = X_global;
    Y_out = Y_global;
    psi_out = psi;implementation_end;
   Constant 688 616
    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\Constant.emx</LibraryPath>
  <TimeStamp>2007-10-19 14:48:44</TimeStamp>
</Description>';
    type Constant
     ports
      signal in in_X_FL;
      signal in in_X_FR;
      signal in in_X_BL;
      signal in in_X_BR;
      signal out z_road_FL;
      signal out z_road_FR;
      signal out z_road_BL;
      signal out z_road_BR;
    end;
    icon bg bottom
     figures
      rectangle 672.1 600 703.9 632 color 0 fill 15132390;
      line 676.9 611.6 698.9 611.6 color 16711680 width 2;
      line 674.2 622.7 699.9 622.7 color 0;
      line 676.5 606.7 676.5 625 color 0;
    end;
    implementation eq
parameters
    real start_bump = 5.0;      // Coordinata X dove inizia il dosso [m]
    real bump_length = 1.5;      // Lunghezza del dosso [m]
    real bump_height = 0.15;     // Altezza del dosso (8 cm) [m]

variables
    // Variabili interne per calcolare l'altezza prima di applicare la derivata
    real z_pos_FL, z_pos_FR, z_pos_BL, z_pos_BR;

equations

    // Calcolo Posizione Z (Altezza del dosso spaziale)
    
    // Ruota Anteriore Sinistra (FL)
    if (in_X_FL >= start_bump) and (in_X_FL <= start_bump + bump_length) then
        z_pos_FL = bump_height * sin(pi * (in_X_FL - start_bump) / bump_length);
    else
        z_pos_FL = 0.0;
    end;

    // Ruota Anteriore Destra (FR)
    if (in_X_FR >= start_bump) and (in_X_FR <= start_bump + bump_length) then
        z_pos_FR = bump_height * sin(pi * (in_X_FR - start_bump) / bump_length);
    else
        z_pos_FR = 0.0;
    end;

    // Ruota Posteriore Sinistra (BL)
    if (in_X_BL >= start_bump) and (in_X_BL <= start_bump + bump_length) then
        z_pos_BL = bump_height * sin(pi * (in_X_BL - start_bump) / bump_length);
    else
        z_pos_BL = 0.0;
    end;

    // Ruota Posteriore Destra (BR)
    if (in_X_BR >= start_bump) and (in_X_BR <= start_bump + bump_length) then
        z_pos_BR = bump_height * sin(pi * (in_X_BR - start_bump) / bump_length);
    else
        z_pos_BR = 0.0;
    end;

    // Derivazione nel tempo (Output verso i blocchi ruota)
    // Converte l'altezza Z in velocità (Flusso) per alimentare correttamente le MSf
    z_road_FL = ddt(z_pos_FL);
    z_road_FR = ddt(z_pos_FR);
    z_road_BL = ddt(z_pos_BL);
    z_road_BR = ddt(z_pos_BR);implementation_end;
   CONTROLLER 688 96
			specifications active 'CONTROLLER'
				specification 'CONTROLLER'
 description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Equation.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues><TimeStamp>2007-11-1 22:32:1</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
 type 'Submodel-Equation'
  ports
   signal in X;
   signal out delta_req;
   signal in psi;
   signal in Y;
 end;
 icon bg
  figures
   rectangle 648 80 728 112 color 0 fill 15132390;
   text 'name' 688 96 color 0 16;
 end;
 implementation eq
parameters
    // Parametri del Controller
    real Ld = 5 {m};         // Distanza di Lookahead fissa
    real L = 2.5 {m};          // Passo dell'auto (Wheelbase = a + b del tuo modello)
    
    // Parametri della Traiettoria (Cambio corsia dolce)
    real Y_amp = 5.0 {m};      // Di quanti metri ci spostiamo lateralmente
    real X_start = 20.0 {m};   // A che coordinata X inizia la manovra
    real k_smooth = 0.6;       // Più è basso, più la sterzata è dolce

variables
    // Ingressi dal Car_Body
//    real in X; 
//    real in Y; 
//    real in psi;
    
    // Uscita verso il Car_Body (che hai già rinominato delta_in)
//    real out delta_req;
    
    // Variabili interne
    real X_target, Y_target;
    real dx, dy;
    real y_local;              // Errore laterale nel sistema di riferimento vettura
    real curvature;

equations
    // PUNTO DI LOOKAHEAD
    // Proiettiamo in avanti di Ld lungo la direzione attuale
    X_target = X + Ld * cos(psi);

    // TRAIETTORIA MATEMATICA (Cambio di corsia)
    // La funzione tanh passa da -1 a 1. 
    // Riscalata, fa passare Y da 0 a Y_amp in modo smooth.
    Y_target = Y_amp * 0.5 * (1 + tanh(k_smooth * (X_target - X_start)));

    // seno
    // Y_target = Y_amp * sin(0.5 * X_target);

    //VETTORE DI ERRORE GLOBALE
    dx = X_target - X;
    dy = Y_target - Y;

    // TRASFORMAZIONE NEL LOCAL FRAME
    // Ruotiamo il vettore errore usando l'angolo di imbardata (psi).
    // A noi interessa solo l'errore laterale "visto" dal muso dell'auto.
    y_local = -dx * sin(psi) + dy * cos(psi);

    // GEOMETRIA PURE PURSUIT
    // Calcolo della curvatura necessaria per beccare il bersaglio
    curvature = (2.0 * y_local) / (Ld * Ld);
    
    // Modello cinematico per l'angolo di sterzo richiesto alle ruote
    delta_req = arctan(curvature * L);
	// delta_req = 0;implementation_end;
specification_end;
			end;
   Differential 288 328
    description '<Information><Description><Version>4.0</Version><LibraryPath>Template\Submodel-Graphical.emx</LibraryPath><IsMainModel>1</IsMainModel><KeepParameterValues>True</KeepParameterValues><TimeStamp>2007-11-1 22:32:34</TimeStamp><AllowLibraryUpdate>False</AllowLibraryUpdate></Description></Information>';
    type 'Submodel-Graphical'
     ports
      power in torque;
      power out output_torque;
    end;
    implementation bg
     submodels
      plug torque 24 96;
      plug output_torque 568 96;
      OneJunction 272 96
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\OneJunction.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:17:51</TimeStamp>
</Description>
</Information>';
       knot OneJunction
        ports
         power knot duplicatable none p [1];
         signal knot out flow [1];
        restrictions
         causality constraint one_out p;
       end;
       icon bg ellipse
        figures
         text '1' 272 96 color 0 18 bold;
       end;
       implementation eq
equations
	sum (direct (p.e)) = 0;
	equal (collect (p.f));
	flow = first (p.f);
implementation_end;
      TF 168 96
       description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\TF.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:43:47</TimeStamp>
</Description>
</Information>';
       type TF
        ports
         power in p1;
         power out p2;
        restrictions
         causality constraint not_equal p1 p2;
       end;
       icon bg ellipse bottom
        figures
         text 'TF' 168 96 color 0 18 bold;
       end;
       implementation eq
parameters
    real global differential_ratio; // (es. 3.5, dichiaralo nei globali!)

variables
    real r_eq; // Rapporto equivalente combinato

equations
    // Calcolo del rapporto che unisce Final Drive e ripartizione differenziale
    r_eq = 2.0 / differential_ratio;

    // p1 è la porta collegata al motore (ingresso)
    // p2 è la porta collegata al giunto 0 (verso le ruote)
    
    // La velocità verso le ruote è ridotta
    p2.f = r_eq * p1.f;
    
    // La coppia dal motore è amplificata
    p1.e = r_eq * p2.e;implementation_end;
     end;
     connections
      OneJunction\p => output_torque;
      TF\p2 => OneJunction\p;
      torque => TF\p1;
     end;
     figures
      rectangle 72 -40 504 24 color 0 fill 13353215;
      text 'DIFFERENTIAL' 288 -8 color 0 32;
    implementation_end;
   MSe 168 328
    description '<Information>
 <Description>
    <Version>4.2</Version>
<IsMainModel>1</IsMainModel>
  <KeepParameterValues>False</KeepParameterValues>
    <LibraryPath>Bond Graph\MSe.emx</LibraryPath>
  <TimeStamp>2011-11-29 16:12:33</TimeStamp>
</Description>
</Information>';
    type MSe
     ports
      power out p;
      signal in effort;
     restrictions
      causality fixed out p;
    end;
    icon bg ellipse bottom
     figures
      text 'MSe' 168 328 color 0 18 bold;
    end;
    implementation eq
variables
	real flow;
equations
	p.e = effort;
	flow = p.f;
implementation_end;
   Ramp 72 328
    description '<Description><Version>4.0</Version><IsMainModel>1</IsMainModel><KeepParameterValues>False</KeepParameterValues>
   <LibraryPath>Signal\Sources\SignalGenerator-Ramp.emx</LibraryPath>
  <TimeStamp>2007-9-27 16:1:50</TimeStamp>
</Description>';
    type 'SignalGenerator-Ramp'
     ports
      signal out output;
    end;
    icon bg bottom
     figures
      rectangle 56 312 88 344 color 0 fill 15132390;
      line 58.9 336 85.1 336 color 0;
      line 61.3 335.8 65.7 336.1 79.1 323.4 color 16711680 width 2;
      line 61.1 320 61.1 338.2 color 0;
    end;
    implementation eq
parameters
	
    real max_torque = 180.0; // [Nm] Coppia necessaria per raggiungere ~30 km/h
    real t1 = 1.0 {s};       // Il pilota inizia a premere l'acceleratore
    real t2 = 2.0 {s};       // Acceleratore premuto al massimo (180 Nm)
    real t3 = 5.0 {s};       // Il pilota inizia a togliere il piede (velocità raggiunta)
    real t4 = 6.0 {s};       // Piede tolto del tutto, coppia a zero (inizio crociera)

variables
    real k_up;
    real k_down;
    boolean hidden c1, c2, c3, c4;

equations
    // Eventi per forzare il solver BDF a non saltare i punti di flesso
    c1 = timeevent(t1);
    c2 = timeevent(t2);
    c3 = timeevent(t3);
    c4 = timeevent(t4);

    // Calcolo delle pendenze di accelerazione e decelerazione
    k_up = max_torque / (t2 - t1);
    k_down = max_torque / (t4 - t3);

    // Profilo a trapezio puramente matematico: sale, mantiene, scende, azzera.
    output = k_up * (ramp(t1) - ramp(t2)) - k_down * (ramp(t3) - ramp(t4));implementation_end;
