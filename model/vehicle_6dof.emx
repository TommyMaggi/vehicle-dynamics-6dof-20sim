       implementation eq
parameters
    real global stiffness_suspension_z;
    real global initial_compression_z; 

equations
    // L'integratore parte dal valore di equilibrio calcolato globalmente
    state = int(p.f, initial_compression_z);
    
    // Generazione della forza elastica
    p.e = state * stiffness_suspension_z;implementation_end;
