</Description>
</Information>';
       type I
        ports
         power in p;
         signal out state;
        restrictions
         causality preferred in p;
       end;
       icon bg ellipse bottom
        figures
         text 'I' 288 192 color 0 18 bold;
       end;
       implementation eq
parameters
	real global inertia_wheel;  //real rotational inertia value wheel (global)
equations
    state = int(p.e);   //state = angular momentum = integral(effort)  //
    p.f = state / inertia_wheel;    //output flow (prende valore di momento angolare e lo divide per l'inerzia)

//questa è l'inerzia che rappresenta la massa della ruota
//l'inerzia prende la coppia netta (input), la integra e decide a che velocità gira la ruota

implementation_end;
